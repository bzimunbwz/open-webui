# ClaudeSK reverse proxy — automatic HTTPS via Let's Encrypt.
# DNS required (A records -> droplet IP): claudesk.pro, www, gateway

claudesk.pro {
	encode zstd gzip

	# Streaming chat responses must not be buffered.
	reverse_proxy open-webui:8080 {
		flush_interval -1
	}
}

www.claudesk.pro {
	redir https://claudesk.pro{uri} permanent
}

# Facade gateway (OpenAI-compatible API + admin endpoints).
# The browser calls this cross-origin; CLI tools can use it directly.
gateway.claudesk.pro {
	encode zstd gzip

	reverse_proxy gateway:3000 {
		flush_interval -1
	}
}
