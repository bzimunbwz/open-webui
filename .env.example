# ===== ClaudeSK environment — copy to .env and fill in. NEVER commit .env =====
# cp .env.example .env && nano .env

# ── Branding ──────────────────────────────────────────────────────────────
WEBUI_NAME=Claudesk
WEBUI_URL=https://claudesk.pro

# Open WebUI session secret. MUST match the old value or all users are logged
# out. Generate a new one only for a fresh install:  openssl rand -hex 32
WEBUI_SECRET_KEY=

# ── Gateway ───────────────────────────────────────────────────────────────
# Admin key for the Providers/Payments pages. Use a long random value —
# do NOT keep the old 'sk-gateway-admin' default, it is public in the repo.
GATEWAY_ADMIN_KEY=

# Max output tokens when the client sends none (prevents truncated answers).
DEFAULT_MAX_TOKENS=16384

# ── Provider API keys (only set the ones you use) ─────────────────────────
BYNARA_API_KEY=
CLOD_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=

# ── Postman Agent Mode (internal /_gw API, session-cookie auth) ────────────
# Base URL is the team subdomain gateway: https://<team-domain>.postman.co/_gw
POSTMAN_BASE_URL=
# One FULL session Cookie string per line (postman.sid=…; _pmt=…; …). Multiple
# cookies = multiple accounts → automatic rotation/fallback on 401/429.
POSTMAN_COOKIES=
# Workspace + user ids from the URL/account (defaults match the test account).
POSTMAN_WORKSPACE_ID=
POSTMAN_USER_ID=
POSTMAN_USER_DOMAIN=

# ── Optional ──────────────────────────────────────────────────────────────
# SOCKS5 proxy, only for Binance crypto payment verification
BINANCE_PROXY=

# ── Signup / access ───────────────────────────────────────────────────────
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=user

# ── Disk hygiene (keep these — they stop the volume filling up) ───────────
RAG_EMBEDDING_ENGINE=openai
AUDIO_STT_ENGINE=openai
ENABLE_WEB_SEARCH=true
WEB_SEARCH_RESULT_COUNT=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
